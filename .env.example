# Neon PostgreSQL Connection String (pooled or direct)
# Format: postgres://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgres://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Local Server Port (Optional)
PORT=3000
